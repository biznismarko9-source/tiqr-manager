rules_version = '2';

// TIQR Manager - Firestore security rules.
//
// 2.0.71: added for the account-approval gate; 2.23.0 added the suggestion
// box as the second (and so far only other) use -
// (stop one person from registering multiple accounts). This is the ONLY
// thing Firestore is used for in this app - see src/lib/firebase.ts's own
// comment on `db` before reaching for Firestore anywhere else without
// updating this file too.
//
// HOW TO APPLY THIS: Firebase Console -> your TIQR Manager project ->
// Firestore Database -> Rules tab -> replace everything there with the
// contents of this file -> Publish. This repo has no Firebase CLI project
// wired up, so these rules are never deployed automatically by anything -
// pasting them into the Console by hand (once, and again any time this file
// changes) is the only way they take effect.
//
// WHAT THIS ACTUALLY ENFORCES: each signed-in Firebase user gets exactly one
// document, at users/{their own uid}, created once by the app itself at
// registration (src/lib/auth.tsx's register() / loginWithGoogle()) with
// approved: false. These rules let that ONE specific write through - a
// brand-new doc, for yourself, with approved explicitly false - and nothing
// else: no updates, no deletes, and no way to create your own doc already
// marked approved: true. The only way approved ever becomes true is marko
// opening this same doc in the Firebase Console's data viewer (Firestore
// Database -> Data tab -> users -> that document) and changing the field by
// hand - Console access authenticates as the project owner, which these
// rules do not apply to at all, by design (that asymmetry - the app can
// never approve itself, only marko's own separate Console session can - is
// the entire point of this file).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Read your own approval status only - never anyone else's.
      allow get: if request.auth != null && request.auth.uid == userId;

      // Create your own doc only, and only ever pending - never pre-approved.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.approved == false;

      // Nobody - including the doc's own owner - can update or delete it
      // from the app. Approving someone is a Console-only action (see above).
      allow update, delete: if false;
    }

    // 2.23.0: the suggestion box in Settings -> Support.
    //
    // Anyone signed in can POST one and nothing else - no reading anyone's
    // (including their own), no editing, no deleting. Reading the whole
    // collection is marko's alone, and "marko" is defined by the `admin` field
    // on his own users/{uid} doc, which only the Console can set (the rules
    // above forbid every update from the app, so the app can never promote
    // itself).
    //
    // TWO THINGS MUST BE DONE BY HAND FOR THIS TO WORK, and nothing in the app
    // can do either: paste this file into the Console's Rules tab and Publish,
    // and set `admin: true` on your own users/{uid} document in the Data tab.
    // Until both are done, sending a suggestion fails with a permission error
    // and the inbox stays hidden - which is the safe way round.
    match /suggestions/{suggestionId} {
      // Post your own, and only ever as a fresh, unanswered one. The shape is
      // pinned here rather than trusted from the client: a suggestion that
      // arrives already marked "done", or attributed to someone else, is not
      // a suggestion.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'new'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    // 2.25.0: the optional screenshot. Either genuinely absent
                    // (null) or a data URL, and capped here as well as in the
                    // client - a rule that trusts the app to have resized the
                    // picture is not a rule. 600k characters is the same
                    // ceiling `shrinkImage` compresses down to, and leaves
                    // room under Firestore's 1 MiB per-document limit for the
                    // text and metadata sharing the document.
                    && (request.resource.data.image == null
                        || (request.resource.data.image is string
                            && request.resource.data.image.size() <= 600000));

      // Only an admin ever reads them. Note `get` on the reader's OWN user doc
      // - that is the one document these rules already let them read.
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;

      // Triaging happens in the Console, the same asymmetry approval uses.
      allow update, delete: if false;
    }

    // Everything else is denied by default (no rule matches -> no access) -
    // there is nothing else in this database to protect yet, but this stays
    // explicit rather than relying on Firestore's own default-deny alone, so
    // it's obvious at a glance that nothing was simply forgotten here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
