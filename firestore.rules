rules_version = '2';

// TIQR Manager - Firestore security rules.
//
// 2.0.71: added for the account-approval gate (stop one person from
// registering multiple accounts); 2.23.0 added the suggestion box; 2.112.0
// added live sync between computers (the users/{uid}/rows|parts|settings|
// devices block below); 2.115.0 added one Gmail reader for two computers
// (users/{uid}/mail). Those four are everything Firestore is used for in
// this app - see src/lib/firebase.ts's own comment on `db` before reaching
// for Firestore anywhere else without updating this file too.
//
// HOW TO APPLY THIS: Firebase Console -> your TIQR Manager project ->
// Firestore Database -> Rules tab -> replace everything there with the
// contents of this file -> Publish. This repo has no Firebase CLI project
// wired up, so these rules are never deployed automatically by anything -
// pasting them into the Console by hand (once, and again any time this file
// changes) is the only way they take effect.
//
// WHAT THIS ACTUALLY ENFORCES: each signed-in Firebase user gets exactly one
// document, at users/{their own uid}, created once by the app itself at
// registration (src/lib/auth.tsx's register() / loginWithGoogle()) with
// approved: false. These rules let that ONE specific write through - a
// brand-new doc, for yourself, with approved explicitly false - and nothing
// else: no updates, no deletes, and no way to create your own doc already
// marked approved: true. The only way approved ever becomes true is marko
// opening this same doc in the Firebase Console's data viewer (Firestore
// Database -> Data tab -> users -> that document) and changing the field by
// hand - Console access authenticates as the project owner, which these
// rules do not apply to at all, by design (that asymmetry - the app can
// never approve itself, only marko's own separate Console session can - is
// the entire point of this file).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Read your own approval status only - never anyone else's.
      allow get: if request.auth != null && request.auth.uid == userId;

      // Create your own doc only, and only ever pending - never pre-approved.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.approved == false;

      // Nobody - including the doc's own owner - can update or delete it
      // from the app. Approving someone is a Console-only action (see above).
      allow update, delete: if false;
    }

    // 2.23.0: the suggestion box in Settings -> Support.
    //
    // Anyone signed in can POST one and nothing else - no reading anyone's
    // (including their own), no editing, no deleting. Reading the whole
    // collection is marko's alone, and "marko" is defined by the `admin` field
    // on his own users/{uid} doc, which only the Console can set (the rules
    // above forbid every update from the app, so the app can never promote
    // itself).
    //
    // TWO THINGS MUST BE DONE BY HAND FOR THIS TO WORK, and nothing in the app
    // can do either: paste this file into the Console's Rules tab and Publish,
    // and set `admin: true` on your own users/{uid} document in the Data tab.
    // Until both are done, sending a suggestion fails with a permission error
    // and the inbox stays hidden - which is the safe way round.
    match /suggestions/{suggestionId} {
      // Post your own, and only ever as a fresh, unanswered one. The shape is
      // pinned here rather than trusted from the client: a suggestion that
      // arrives already marked "done", or attributed to someone else, is not
      // a suggestion.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'new'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    // 2.25.0: the optional screenshot. Either genuinely absent
                    // (null) or a data URL, and capped here as well as in the
                    // client - a rule that trusts the app to have resized the
                    // picture is not a rule. 600k characters is the same
                    // ceiling `shrinkImage` compresses down to, and leaves
                    // room under Firestore's 1 MiB per-document limit for the
                    // text and metadata sharing the document.
                    && (request.resource.data.image == null
                        || (request.resource.data.image is string
                            && request.resource.data.image.size() <= 600000));

      // Only an admin ever reads them. Note `get` on the reader's OWN user doc
      // - that is the one document these rules already let them read.
      allow read: if request.auth != null
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;

      // Triaging happens in the Console, the same asymmetry approval uses.
      allow update, delete: if false;
    }

    // 2.112.0: live sync between marko's computers (src/lib/liveSync.ts,
    // src-tauri/src/commands/live_sync.rs). Everything sits under the
    // signed-in account's own users/{uid}, and nobody else's is readable or
    // writable - not even by another approved account.
    //
    //   rows/{table~uid}   one document per record
    //   parts/{id}         the body of a record too big for one document
    //   settings/{group}   mail rules + senders, webhooks
    //   devices/{id}       which computers sync live
    //
    // The one rule that matters most is `replacesStored`: a document is only
    // ever replaced by a NEWER version of the record, and a deletion is only
    // ever replaced by another deletion. Two computers sending at the same
    // moment therefore cannot undo each other's newer change, and nothing can
    // bring a deleted record back - whichever reaches Firestore first.
    match /users/{userId}/rows/{docId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validRow(docId);
      allow update: if isOwner(userId) && validRow(docId) && replacesStored();
      allow delete: if false;
    }

    match /users/{userId}/parts/{partId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && request.resource.data.keys().hasOnly(['p'])
                            && request.resource.data.p is string;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/settings/{group} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validSettings(group);
      allow update: if isOwner(userId) && validSettings(group)
                    && request.resource.data.stamp > resource.data.stamp;
      allow delete: if false;
    }

    match /users/{userId}/devices/{deviceId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && request.resource.data.keys().hasOnly(['live', 'lastSeen', 'platform'])
                            && request.resource.data.live is bool;
      allow delete: if isOwner(userId);
    }

    // 2.115.0: two computers, one Gmail reader (src/lib/mailShareSession.ts,
    // src-tauri/src/commands/mail_share.rs). Two computers reading the same
    // mailbox at once went over what Gmail allows one account, and Google
    // slowed both down. While both run, the one holding the lease reads Gmail
    // and sends the other what it stored, one batch at a time; the other
    // deletes each batch as soon as it has stored it, so mail only passes
    // through here.
    //
    //   lease~{mailbox}              who reads Gmail for that mailbox (a hash
    //                                of the address, never the address)
    //   cursor~{follower}~{reader}   how far the follower has got, and that it
    //                                is there - written by the follower only
    //   drop~{follower}~{seq}        one batch for the follower
    //
    // Under the account's own users/{uid} like live sync: nobody else's is
    // readable or writable. Every document is {dev, at, p} - the computer that
    // wrote it, the server's time, and a JSON string the app checks again
    // before using anything in it.
    match /users/{userId}/mail/{docId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validMail(docId);
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validRow(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['t', 'u', 'h', 'del', 'dev', 'at', 'body', 'parts'])
          && d.t is string && d.u is string && docId == d.t + '~' + d.u
          && d.h is int && d.del is bool && d.dev is string
          && (d.get('body', null) is string || d.get('parts', null) is int)
          && d.at == request.time;
    }

    // Newer by the hybrid clock `h`; for the same clock, the higher device id
    // - so both computers always agree which version that is.
    function replacesStored() {
      let next = request.resource.data;
      let cur = resource.data;
      return (next.del == true && cur.del != true)
          || (next.del == cur.del
              && (next.h > cur.h || (next.h == cur.h && next.dev > cur.dev)));
    }

    function validSettings(group) {
      let d = request.resource.data;
      return d.keys().hasOnly(['group', 'stamp', 'dev', 'body', 'at'])
          && d.group == group && d.stamp is string && d.body is string
          && d.at == request.time;
    }

    function validMail(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['dev', 'at', 'p'])
          && d.dev is string && d.dev.matches('^[0-9a-f]{32}$')
          && d.p is string
          && d.at == request.time
          && ((docId.matches('^lease~[0-9a-f]{16}$') && d.p.size() <= 2000)
              || (docId.matches('^cursor~' + d.dev + '~[0-9a-f]{32}$') && d.p.size() <= 2000)
              // Under Firestore's 1 MiB a document, accents and all - the app
              // sends at most 600,000 bytes of mail in one.
              || (docId.matches('^drop~[0-9a-f]{32}~[0-9a-z]{12}$') && d.p.size() <= 900000));
    }

    // Everything else is denied by default (no rule matches -> no access) -
    // there is nothing else in this database to protect yet, but this stays
    // explicit rather than relying on Firestore's own default-deny alone, so
    // it's obvious at a glance that nothing was simply forgotten here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
